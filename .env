sudo certbot --nginx certonly -d chalet.kiapoynt.com -d www.chalet.kiapoynt.com

mkdir -p chalet.kiapoynt.com/logs chalet.kiapoynt.com/public
chmod -R 755 chalet.kiapoynt.com

sudo nano chalet.kiapoynt.com

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name chalet.kiapoynt.com;

    ssl_certificate /etc/letsencrypt/live/chalet.kiapoynt.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chalet.kiapoynt.com/privkey.pem;

    access_log /home/ubuntu/chalet.kiapoynt.com/logs/access.log;
    error_log /home/ubuntu/chalet.kiapoynt.com/logs/error.log;

    root /home/ubuntu/chalet.kiapoynt.com/public/;

}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name www.chalet.kiapoynt.com;

    ssl_certificate /etc/letsencrypt/live/chalet.kiapoynt.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chalet.kiapoynt.com/privkey.pem;

    return 301 https://chalet.kiapoynt.com$request_uri;
}

server {
    listen 80;
    listen [::]:80;

    server_name chalet.kiapoynt.com www.chalet.kiapoynt.com;

    return 301 https://chalet.kiapoynt.com$request_uri;
}

sudo ln -s /etc/nginx/sites-available/chalet.kiapoynt.com /etc/nginx/sites-enabled/chalet.kiapoynt.com
